{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riaevangelist.github.io/life-first-framework/schemas/decision-record.schema.json",
  "title": "Life First Decision Record",
  "description": "A machine-readable record for a scoped consequential AI-assisted decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "decision_id",
    "created_at",
    "system",
    "risk_tier",
    "purpose",
    "evidence",
    "uncertainty",
    "options",
    "selected_action",
    "data_minimization",
    "review",
    "agency",
    "safeguards",
    "monitoring",
    "authorization"
  ],
  "properties": {
    "record_version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "workflow"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "workflow": { "type": "string", "minLength": 1 }
      }
    },
    "risk_tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legitimate_purpose", "authority", "affected_people", "intended_benefit", "excluded_uses"],
      "properties": {
        "legitimate_purpose": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "affected_people": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "intended_benefit": { "type": "string", "minLength": 1 },
        "excluded_uses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "classification", "source", "confidence", "limitations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["observed", "inference", "generated", "unknown"]
          },
          "source": { "type": "string", "minLength": 1 },
          "confidence": {
            "enum": ["verified", "supported", "uncertain", "contradicted", "unknown"]
          },
          "limitations": { "type": "string" },
          "corroboration": { "type": "string" }
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "expected_benefit", "foreseeable_harm", "reversible", "selected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "expected_benefit": { "type": "string" },
          "foreseeable_harm": { "type": "string" },
          "reversible": { "type": "boolean" },
          "selected": { "type": "boolean" }
        }
      }
    },
    "selected_action": {
      "type": "string",
      "minLength": 1
    },
    "data_minimization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "retention", "access_roles"],
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "retention": { "type": "string", "minLength": 1 },
        "access_roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountable_owner", "required_reviewers", "status", "reviewed_at"],
      "properties": {
        "accountable_owner": { "type": "string", "minLength": 1 },
        "required_reviewers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "status": {
          "enum": ["approved", "approved_with_conditions", "paused", "rejected", "expired"]
        },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice", "human_alternative", "correction", "appeal", "accessible"],
      "properties": {
        "notice": { "type": "string", "minLength": 1 },
        "human_alternative": { "type": "string", "minLength": 1 },
        "correction": { "type": "string", "minLength": 1 },
        "appeal": { "type": "string", "minLength": 1 },
        "accessible": { "type": "boolean" }
      }
    },
    "safeguards": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "warning_threshold", "stop_threshold", "owner"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "warning_threshold": { "type": "string", "minLength": 1 },
          "stop_threshold": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_decision", "owner_name", "authorized_at", "expires_at"],
      "properties": {
        "owner_decision": { "enum": ["approved", "approved_with_conditions", "paused", "rejected"] },
        "owner_name": { "type": "string", "minLength": 1 },
        "independent_approver": { "type": ["string", "null"] },
        "authorized_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "outcome": {
      "type": ["string", "null"]
    },
    "learning": {
      "type": ["string", "null"]
    }
  }
}
